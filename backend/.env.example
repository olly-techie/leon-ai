APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173

# Neon Postgres — pooled for app queries
DATABASE_URL=postgres://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require&pool=true
# Direct connection for schema migrations (bypasses pooler)
DATABASE_DIRECT_URL=postgres://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# OpenRouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_FAST_MODEL=google/gemini-2.5-flash
OPENROUTER_STRONG_MODEL=google/gemini-2.5-pro
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME="Defence Panel"

# Auth — generate a long random string for production
JWT_SECRET=change-me-to-a-long-random-string

# Configuration
MAX_UPLOAD_SIZE=15728640        # 15MB in bytes
MAX_SESSION_TURNS=6              # max turns before session auto-completes
RATE_LIMIT_AUTH=10,60            # max requests, window in seconds
RATE_LIMIT_UPLOAD=10,300         # max requests, window in seconds
RATE_LIMIT_SESSION_START=20,300  # max requests, window in seconds
RATE_LIMIT_SESSION_ANSWER=60,60  # max requests, window in seconds
